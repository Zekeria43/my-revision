# ---------------------------------------------------------------
# مراجعتي — Ma Révision — My Revision
# Copy to .env.local and fill in real values. NEVER commit secrets.
# ---------------------------------------------------------------

# --- Runtime ---
# development | production
NODE_ENV=development
# Public base URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Absolute URL used in server-side links/emails
APP_URL=http://localhost:3000

# --- Database ---
# LOCAL (default): zero-config SQLite file.
DATABASE_URL="file:./dev.db"
# PRODUCTION (Supabase / PostgreSQL): switch prisma/schema.prisma provider to "postgresql"
# and use the connection string from Supabase > Project Settings > Database.
# DATABASE_URL="postgresql://postgres.<PROJECT>.supabase.co:6543/postgres?sslmode=require"
# DIRECT_URL (Prisma migrate accelerate / pooled connection)
# DIRECT_URL="postgresql://postgres.<PROJECT>.supabase.co:5432/postgres?sslmode=require"

# --- Authentication ---
# 32+ random bytes, hex or base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-secret
# Session lifetime in days
SESSION_DAYS=30
# bcrypt cost (10-14)
BCRYPT_ROUNDS=12

# --- Email ---
# console (development): emails are printed to the server log instead of being sent.
# smtp    (production) : real delivery through any SMTP server.
# brevo   (production) : real delivery through the Brevo HTTP API (recommended).
AUTH_EMAIL_MODE=console
# --- SMTP (used when AUTH_EMAIL_MODE=smtp) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="مراجعتي <no-reply@marevision.app>"
# --- Brevo (used when AUTH_EMAIL_MODE=brevo) ---
# Server-side only. NEVER commit real values, NEVER expose to the client.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Rolling 24h transactional-email quota per address, shared across
# verification + resend + password recovery (min 1, default 3).
# Enforced atomically server-side; failed sends are refunded.
EMAIL_DAILY_SEND_LIMIT=3

# --- Storage ---
# local  : files stored in ./uploads (private, served through an authorised route)
# supabase: files stored in a private Supabase Storage bucket
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resources

# --- Notifications ---
# Enable scheduled notification generation through a cron hitting /api/cron/notifications
CRON_SECRET=
# Optional web-push (requires VAPID keys; generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin bootstrap ---
# Email granted the administrator role on first run of `npm run db:seed`.
# Roles are ONLY assignable through this server-side process.
ADMIN_EMAIL=admin@marevision.app
# --- Owner (provisioned ONLY by `npm run db:seed`; never via any action) ---
# OWNER_EMAIL=owner@marevision.app
# OWNER_PASSWORD=
